w.color// Archivo: ThreeBinsAnimation.jsx // Descripción: Componente React que simula 3 tachos de basura (verde, azul, rojo), // cada uno con sensor y alarma. Al 'botar' un residuo en un tacho, se comprueba // si corresponde; si no, suena la alarma y parpadea el tacho. // Requisitos: Tailwind CSS y framer-motion instalados en tu proyecto. // Cómo usar: // 1) Copia este archivo en tu proyecto React (por ejemplo, src/components/ThreeBinsAnimation.jsx). // 2) Asegúrate de tener tailwind configurado y framer-motion instalado: npm install framer-motion. // 3) Importa y monta el componente en tu App. // 4) Para exportar video: abre la app en el navegador y usa un grabador de pantalla (OBS/ScreenRec.) //    o usa una herramienta que capture canvas/DOM (ej. CCapture.js) para generar un mp4.

import React, { useState, useRef } from 'react'; import { motion, AnimatePresence } from 'framer-motion';

// Tipos de residuo const WASTES = { ORGANIC: { id: 'organic', label: 'Orgánico', color: 'green' }, RECYCLE: { id: 'recycle', label: 'Reciclable', color: 'blue' }, HAZARD: { id: 'hazard', label: 'Peligroso', color: 'red' }, };

// Config de tachos const BINS = [ { id: 'bin-organic', type: WASTES.ORGANIC.id, label: 'Orgánicos', color: 'bg-green-500' }, { id: 'bin-recycle', type: WASTES.RECYCLE.id, label: 'Reciclables', color: 'bg-blue-500' }, { id: 'bin-hazard', type: WASTES.HAZARD.id, label: 'Peligrosos', color: 'bg-red-500' }, ];

export default function ThreeBinsAnimation() { const [floatingItems, setFloatingItems] = useState([]); // items en vuelo const [alarms, setAlarms] = useState({}); // {binId: bool} const idCounter = useRef(0);

// Generador de tono simple usando WebAudio function beep(freq = 880, duration = 150) { try { const ctx = new (window.AudioContext || window.webkitAudioContext)(); const o = ctx.createOscillator(); const g = ctx.createGain(); o.type = 'sine'; o.frequency.value = freq; o.connect(g); g.connect(ctx.destination); o.start(); g.gain.setValueAtTime(0.0001, ctx.currentTime); g.gain.exponentialRampToValueAtTime(0.2, ctx.currentTime + 0.01); g.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + duration / 1000); o.stop(ctx.currentTime + duration / 1000 + 0.02); } catch (e) { // audio puede fallar en algunos entornos console.warn('Audio API no disponible', e); } }

function dropWaste(waste) { // crea un objeto en vuelo que caerá en el tacho seleccionado por el usuario const newItem = { uid: ++idCounter.current, type: waste.id, label: waste.label, color: waste.color, targetBin: null, // se especifica al 'botar' en un tacho yOffset: -180, state: 'idle', // idle -> falling -> landed }; setFloatingItems((s) => [newItem, ...s]); }

function handleDropOnBin(itemUid, bin) { setFloatingItems((items) => items.map((it) => (it.uid === itemUid ? { ...it, targetBin: bin.id, state: 'falling' } : it)) );

// small timeout to let animation start then evaluate
setTimeout(() => {
  const item = floatingItems.find((i) => i.uid === itemUid);
  // If not found (race), just evaluate using latest state
  const current = (floatingItems.find((i) => i.uid === itemUid) || {}).type || null;
  const wasteType = (item && item.type) || current;
  const correct = wasteType === bin.type;
  if (!correct) {
    // activar alarma visual y sonora en el tacho
    activateAlarm(bin.id);
  }
  // marcar item como landed y removerlo visualmente
  setFloatingItems((prev) => prev.filter((i) => i.uid !== itemUid));
}, 700);

}

function activateAlarm(binId) { setAlarms((a) => ({ ...a, [binId]: true })); beep(1000, 300); // alarmas parpadean 1.8s setTimeout(() => setAlarms((a) => ({ ...a, [binId]: false })), 1800); }

// Helper: render un tacho function Bin({ bin }) { const isAlarming = !!alarms[bin.id]; return ( <div className="flex flex-col items-center w-1/3 p-4"> <div className={w-48 h-56 rounded-t-xl relative overflow-hidden shadow-lg ${bin.color} ${isAlarming ? 'ring-4 ring-yellow-300 animate-pulse' : ''}}> {/* tapa del tacho /} <div className="absolute -top-4 left-4 w-40 h-6 rounded-lg bg-black/40" /> {/ sensor (pequeño círculo) /} <div className="absolute top-2 right-3 flex items-center gap-2"> <div className={w-3 h-3 rounded-full ${isAlarming ? 'bg-yellow-400' : 'bg-black'}} /> <span className="text-xs text-white/90 pr-2">Sensor</span> </div> {/ etiqueta interior */} <div className="absolute bottom-2 left-2 text-white/90 font-semibold">{bin.label}</div> </div> <div className="mt-3 flex items-center gap-3"> <button className="px-3 py-1 rounded bg-white/90 text-black shadow" onClick={() => playTestSensor(bin)} > Probar sensor </button> </div> </div> ); }

function playTestSensor(bin) { // Simula detección errónea para demostrar alarma activateAlarm(bin.id); }

return ( <div className="min-h-screen bg-gray-50 p-6"> <div className="max-w-5xl mx-auto"> <h1 className="text-2xl font-bold mb-4">Simulación: 3 tachos con sensores y alarmas</h1>

<p className="mb-4">Genera un residuo (botón). Luego haz clic en el tacho donde quieras lanzarlo. Si el residuo no corresponde al tacho, suena la alarma.</p>

    <div className="mb-6 flex gap-4">
      {/* botones para crear residuos */}
      {Object.values(WASTES).map((w) => (
        <button
          key={w.id}
          onClick={() => dropWaste(w)}
          className={`px-4 py-2 rounded shadow text-white font-semibold ${w.color === 'green' ? 'bg-green-600' : w.color === 'blue' ? 'bg-blue-600' : 'bg-red-600'}`}
        >
          Crear: {w.label}
        </button>
      ))}

      <div className="ml-auto text-sm text-gray-600">Tip: crea varios residuos y luego clic en un tacho para lanzarlos allí.</div>
    </div>

    {/* zona visual: tachos */}
    <div className="flex gap-4 relative bg-white p-6 rounded shadow">
      {BINS.map((b) => (
        <div key={b.id} className="w-1/3">
          <Bin bin={b} />
        </div>
      ))}

      {/* Items flotantes (en orden): los mostramos en overlay para animarlos hacia el tacho cuando el usuario hace click en un tacho */}
    </div>

    {/* Overlay de interacción: lista de residuos que están esperando ser lanzados */}
    <div className="mt-6 p-4 bg-white rounded shadow">
      <h2 className="font-semibold mb-2">Residuos listos para lanzar</h2>
      <div className="flex gap-3 items-start">
        <div className="flex-1 grid grid-cols-4 gap-3">
          <AnimatePresence>
            {floatingItems.map((it) => (
              <motion.div
                key={it.uid}
                initial={{ y: -10, opacity: 0.9, scale: 0.95 }}
                animate={{ y: 0, opacity: 1, scale: 1 }}
                exit={{ opacity: 0, scale: 0.9 }}
                className="p-2 rounded shadow flex flex-col items-center bg-white"
              >
                <div className="w-full flex justify-between items-center">
                  <div className="text-sm font-medium">{it.label}</div>
                  <div className={`w-3 h-3 rounded-full ${it.color === 'green' ? 'bg-green-600' : it.color === 'blue' ? 'bg-blue-600' : 'bg-red-600'}`} />
                </div>

                <div className="mt-2 flex gap-2">
                  {BINS.map((bin) => (
                    <button
                      key={bin.id}
                      onClick={() => handleDropOnBin(it.uid, bin)}
                      className="px-2 py-1 bg-gray-100 rounded text-sm shadow"
                    >
                      Lanzar a {bin.label}
                    </button>
                  ))}
                </div>
              </motion.div>
            ))}
          </AnimatePresence>
        </div>

        <div className="w-80">
          <h3 className="font-medium">Controles</h3>
          <p className="text-sm text-gray-600 mb-2">Puedes crear varios residuos y luego enviarlos a cualquiera de los tachos. Las alarmas se activan automáticamente cuando se detecta un residuo inapropiado.</p>
          <div className="flex gap-2">
            <button
              className="px-3 py-1 bg-black text-white rounded"
              onClick={() => {
                // generar ejemplo rápido: 3 residuos y lanzarlos en el orden incorrecto para demostrar alarmas
                dropWaste(WASTES.ORGANIC);
                dropWaste(WASTES.RECYCLE);
                dropWaste(WASTES.HAZARD);
              }}
            >
              Generar 3 ejemplos
            </button>
            <button
              className="px-3 py-1 bg-gray-200 rounded"
              onClick={() => {
                setFloatingItems([]);
                setAlarms({});
              }}
            >
              Limpiar
            </button>
          </div>
        </div>
      </div>
    </div>

    <div className="mt-6 text-gray-600 text-sm">
      <strong>Exportar video</strong>: Para convertir esta animación en un MP4 puedes:
      <ul className="list-disc ml-6 mt-2">
        <li>Grabar la ventana del navegador con OBS Studio o cualquier grabador de pantalla.</li>
        <li>Usar CCapture.js para capturar frames y luego convertirlos a video (más avanzado).</li>
        <li>O usar un headless browser + Puppeteer para renderizar automáticamente cuadros y generar un video (requiere programación adicional).</li>
      </ul>
    </div>
  </div>
</div>

); }

